{
  "feature": "show",
  "about": "Show commands. Every one also takes | json, | include WORD and | exclude WORD.",
  "commands": [
    {"modes": ["priv"], "syntax": "show running-config", "handler": "show.running-config",
     "help": {"show": "Show status and settings", "running-config": "The configuration, as commands that rebuild it"}},
    {"modes": ["priv"], "syntax": "show running-config openconfig", "handler": "show.running-config-openconfig",
     "help": {"openconfig": "The configuration in OpenConfig's JSON form"}},
    {"modes": ["user", "priv"], "syntax": "show version", "handler": "show.version",
     "help": {"show": "Show status and settings", "version": "Software, device kind and backend"}},
    {"modes": ["user", "priv"], "syntax": "show interfaces", "handler": "show.interfaces",
     "help": {"interfaces": "Details of every interface: state, MAC, addresses, VLANs, shaping"}},
    {"modes": ["user", "priv"], "syntax": "show interfaces IFNAME", "args": {"IFNAME": "ifname"}, "handler": "show.interfaces",
     "help": {"IFNAME": "The interface to describe"}},
    {"modes": ["user", "priv"], "syntax": "show interface brief", "handler": "show.interface-brief",
     "help": {"interface": "Interfaces", "brief": "One line per interface"}},
    {"modes": ["user", "priv"], "syntax": "show ip interface brief", "handler": "show.interface-brief",
     "help": {"ip": "IPv4 status", "interface": "Interfaces", "brief": "One line per interface"}},
    {"modes": ["user", "priv"], "kinds": ["router", "host", "server", "switch"], "syntax": "show ip route", "handler": "show.ip-route",
     "help": {"route": "Routing table: where each network is sent"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show ip dhcp snooping", "handler": "show.dhcp-snooping",
     "help": {"dhcp": "DHCP", "snooping": "Whether DHCP snooping is on, which ports are trusted and what was dropped"}},
    {"modes": ["user", "priv"], "kinds": ["router"], "syntax": "show ip rip", "handler": "show.ip-rip",
     "help": {"ip": "IPv4 status", "rip": "The RIP table: connected and learned networks with metric and next hop"}},
    {"modes": ["user", "priv"], "kinds": ["router", "host", "server", "switch"], "syntax": "show arp", "handler": "show.arp",
     "help": {"arp": "IPv4 address to MAC address table"}},
    {"modes": ["user", "priv"], "kinds": ["router"], "syntax": "show access-lists", "handler": "show.access-lists",
     "help": {"access-lists": "Packet filters, their rules and where they are applied"}},
    {"modes": ["user", "priv"], "kinds": ["router"], "syntax": "show access-lists NAME", "args": {"NAME": "word"}, "handler": "show.access-lists",
     "help": {"NAME": "One list"}},
    {"modes": ["user", "priv"], "kinds": ["router"], "syntax": "show ip nat translations", "handler": "show.nat-translations",
     "help": {"nat": "Address translation", "translations": "The fixed mappings and the flows being translated now"}},
    {"modes": ["user", "priv"], "kinds": ["router"], "syntax": "show ip nat statistics", "handler": "show.nat-statistics",
     "help": {"statistics": "Interfaces, rules and how often the table was used"}},
    {"modes": ["user", "priv"], "kinds": ["router", "host", "server"], "syntax": "show ip dhcp binding", "handler": "show.dhcp-binding",
     "help": {"dhcp": "DHCP server", "binding": "Addresses this server has handed out"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show mac address-table", "handler": "show.mac-table",
     "help": {"mac": "MAC addresses", "address-table": "Which port each MAC address was seen on"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show port-security", "handler": "show.port-security",
     "help": {"port-security": "Limits on how many hosts a switch port accepts, and the violations so far"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show storm-control", "handler": "show.storm-control",
     "help": {"storm-control": "Broadcast limits per switch port, and how many frames each let through or dropped"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show monitor", "handler": "show.monitor",
     "help": {"show": "Show device state", "monitor": "Port mirroring sessions: destination and source ports"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show etherchannel summary", "handler": "show.etherchannel",
     "help": {"etherchannel": "Port-channels (link aggregation)", "summary": "One line per channel, with the state of each member port"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show spanning-tree", "handler": "show.spanning-tree",
     "help": {"spanning-tree": "Root bridge, port roles and states"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show spanning-tree interface IFNAME", "args": {"IFNAME": "ifname"}, "handler": "show.spanning-tree-interface",
     "help": {"interface": "One port", "IFNAME": "The port to describe"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show vlan id VLAN", "args": {"VLAN": "vlan-id"}, "handler": "show.vlan-id",
     "help": {"id": "One VLAN", "VLAN": "VLAN number, 1-4094"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show vlan brief", "handler": "show.vlan-brief",
     "help": {"vlan": "VLANs", "brief": "VLANs with their access ports, and the trunks"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show vlan", "handler": "show.vlan-brief",
     "help": {"vlan": "VLANs"}}
  ]
}
