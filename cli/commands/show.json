{
  "feature": "show",
  "about": "Show commands. Every one also takes | json, | include WORD and | exclude WORD.",
  "commands": [
    {"modes": ["priv"], "syntax": "show running-config", "handler": "show.running-config",
     "help": {"show": "Show status and settings", "running-config": "The configuration, as commands that rebuild it"}},
    {"modes": ["priv"], "syntax": "show running-config openconfig", "handler": "show.running-config-openconfig",
     "help": {"openconfig": "The configuration in OpenConfig's JSON form"}},
    {"modes": ["user", "priv"], "syntax": "show version", "handler": "show.version",
     "help": {"show": "Show status and settings", "version": "Software, device kind and backend"}},
    {"modes": ["user", "priv"], "syntax": "show interface brief", "handler": "show.interface-brief",
     "help": {"interface": "Interfaces", "brief": "One line per interface"}},
    {"modes": ["user", "priv"], "syntax": "show ip interface brief", "handler": "show.interface-brief",
     "help": {"ip": "IPv4 status", "interface": "Interfaces", "brief": "One line per interface"}},
    {"modes": ["user", "priv"], "kinds": ["router", "host", "server"], "syntax": "show ip route", "handler": "show.ip-route",
     "help": {"route": "Routing table: where each network is sent"}},
    {"modes": ["user", "priv"], "kinds": ["router", "host", "server"], "syntax": "show arp", "handler": "show.arp",
     "help": {"arp": "IPv4 address to MAC address table"}},
    {"modes": ["user", "priv"], "kinds": ["router", "host", "server"], "syntax": "show ip dhcp binding", "handler": "show.dhcp-binding",
     "help": {"dhcp": "DHCP server", "binding": "Addresses this server has handed out"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show mac address-table", "handler": "show.mac-table",
     "help": {"mac": "MAC addresses", "address-table": "Which port each MAC address was seen on"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show spanning-tree", "handler": "show.spanning-tree",
     "help": {"spanning-tree": "Root bridge, port roles and states"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show vlan brief", "handler": "show.vlan-brief",
     "help": {"vlan": "VLANs", "brief": "VLANs with their access ports, and the trunks"}},
    {"modes": ["user", "priv"], "kinds": ["switch"], "syntax": "show vlan", "handler": "show.vlan-brief",
     "help": {"vlan": "VLANs"}},

    {"modes": ["user", "priv"], "kinds": ["router", "host", "server"], "syntax": "ping ADDRESS", "args": {"ADDRESS": "ipv4-address"}, "handler": "tools.ping",
     "help": {"ping": "Send one echo request and wait for the reply", "ADDRESS": "Address to ping"}},
    {"modes": ["user", "priv"], "kinds": ["router", "host", "server"], "syntax": "traceroute ADDRESS", "args": {"ADDRESS": "ipv4-address"}, "handler": "tools.traceroute",
     "help": {"traceroute": "List the routers on the way to an address", "ADDRESS": "Destination address"}}
  ]
}
