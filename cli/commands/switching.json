{
  "feature": "switching",
  "about": "Access and trunk ports, spanning tree. Common industry syntax.",
  "commands": [
    {"modes": ["config"], "kinds": ["switch"], "syntax": "vlan VLAN", "args": {"VLAN": "vlan-id"}, "handler": "vlan.select", "enter": "config-vlan",
     "help": {"vlan": "Create a VLAN or change its settings", "VLAN": "VLAN number"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no vlan VLAN", "args": {"VLAN": "vlan-id"}, "handler": "vlan.no-vlan",
     "help": {"vlan": "Remove a VLAN's name", "VLAN": "VLAN number"}},
    {"modes": ["config-vlan"], "syntax": "name NAME", "args": {"NAME": "word"}, "handler": "vlan.name",
     "help": {"name": "Give this VLAN a label shown in show vlan", "NAME": "Label"}},
    {"modes": ["config-vlan"], "syntax": "no name", "handler": "vlan.no-name",
     "help": {"name": "Remove the label"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "switchport mode access", "handler": "switchport.mode:access",
     "help": {"switchport": "VLAN settings of this switch port", "mode": "Access port (one VLAN) or trunk (several, tagged)", "access": "Carry one VLAN, untagged"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "switchport mode trunk", "handler": "switchport.mode:trunk",
     "help": {"trunk": "Carry several VLANs, tagged"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "switchport access vlan VLAN", "args": {"VLAN": "vlan-id"}, "handler": "switchport.access-vlan",
     "help": {"access": "Settings for an access port", "vlan": "The VLAN this port belongs to", "VLAN": "VLAN number"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "switchport trunk allowed vlan VLANS", "args": {"VLANS": "vlan-list"}, "handler": "switchport.trunk-allowed",
     "help": {"trunk": "Settings for a trunk port", "allowed": "Which VLANs the trunk carries", "vlan": "VLAN list", "VLANS": "VLANs, like 10,20,30-35"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "switchport trunk native vlan VLAN", "args": {"VLAN": "vlan-id"}, "handler": "switchport.trunk-native",
     "help": {"native": "The VLAN sent untagged on this trunk", "VLAN": "VLAN number"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "no switchport access vlan", "handler": "switchport.no-access-vlan",
     "help": {"no": "Undo a setting", "switchport": "VLAN settings of this switch port", "access": "Put the port back in VLAN 1"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "no switchport trunk native vlan", "handler": "switchport.no-trunk-native",
     "help": {"native": "Use the default native VLAN again"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "no switchport mode", "handler": "switchport.remove",
     "help": {"mode": "Forget this port's VLAN settings"}},

    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "channel-group NUMBER mode active", "args": {"NUMBER": "uint:1-64"}, "handler": "lag.join",
     "help": {"channel-group": "Bundle this port with others into a port-channel (LACP, 802.3ad)", "NUMBER": "Channel number: makes interface Po<NUMBER>", "mode": "How the channel is negotiated", "active": "Send LACPDUs (the only mode the engine models)"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "no channel-group", "handler": "lag.leave",
     "help": {"no": "Undo a setting", "channel-group": "Take this port out of its port-channel"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "lacp rate fast", "handler": "lag.rate:fast",
     "help": {"lacp": "LACP settings of a port-channel", "rate": "How often the peer should send LACPDUs", "fast": "Every second (default: every 30 seconds)"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "lacp rate slow", "handler": "lag.rate:slow",
     "help": {"lacp": "LACP settings of a port-channel", "rate": "How often the peer should send LACPDUs", "slow": "Every 30 seconds (the default)"}},

    {"modes": ["config"], "kinds": ["switch"], "syntax": "spanning-tree", "handler": "stp.enable",
     "help": {"spanning-tree": "Spanning tree (802.1D): blocks ports that would make a loop"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no spanning-tree", "handler": "stp.disable",
     "help": {"no": "Undo a setting", "spanning-tree": "Turn spanning tree off (and forget its settings)"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "lldp forward", "handler": "bridge.lldp-forward",
     "help": {"lldp": "Link Layer Discovery Protocol", "forward": "Pass LLDP frames through this switch instead of dropping them (the switch itself does not speak LLDP)"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no lldp forward", "handler": "bridge.no-lldp-forward",
     "help": {"no": "Undo a setting", "lldp": "Link Layer Discovery Protocol", "forward": "Drop LLDP frames again (the default)"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "mac address-table aging-time SECONDS", "args": {"SECONDS": "uint:1-1000000"}, "handler": "fdb.aging",
     "help": {"mac": "MAC address table settings", "address-table": "The table of which port each MAC address lives on", "aging-time": "Seconds an unused entry is kept (default 300)", "SECONDS": "Seconds"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no mac address-table aging-time", "handler": "fdb.aging.unset",
     "help": {"no": "Undo a setting", "mac": "MAC address table settings", "address-table": "The table of which port each MAC address lives on", "aging-time": "Back to the default (300 seconds)"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "spanning-tree mode stp", "handler": "stp.mode:STP",
     "help": {"mode": "Which spanning tree protocol runs", "stp": "Classic spanning tree (802.1D): timers decide when a port may forward"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "spanning-tree mode rstp", "handler": "stp.mode:RSTP",
     "help": {"rstp": "Rapid spanning tree (802.1w): neighbours agree with proposals and agreements, so ports forward in moments"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no spanning-tree mode", "handler": "stp.mode.unset",
     "help": {"mode": "Back to classic spanning tree"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "spanning-tree priority PRIORITY", "args": {"PRIORITY": "uint:0-65535"}, "handler": "stp.set:bridge-priority",
     "help": {"priority": "Bridge priority: the lowest becomes the root", "PRIORITY": "Priority (default 32768)"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "spanning-tree hello-time SECONDS", "args": {"SECONDS": "uint:1-10"}, "handler": "stp.set:hello-time",
     "help": {"hello-time": "Seconds between hello messages (default 2)", "SECONDS": "Seconds"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "spanning-tree max-age SECONDS", "args": {"SECONDS": "uint:6-40"}, "handler": "stp.set:max-age",
     "help": {"max-age": "Seconds before a silent root is forgotten (default 20)", "SECONDS": "Seconds"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "spanning-tree forward-time SECONDS", "args": {"SECONDS": "uint:4-30"}, "handler": "stp.set:forwarding-delay",
     "help": {"forward-time": "Seconds spent listening, then learning, before forwarding (default 15)", "SECONDS": "Seconds"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "spanning-tree bridge-address MAC", "args": {"MAC": "mac"}, "handler": "stp.set:openpacketrouter:bridge-address",
     "help": {"bridge-address": "MAC address used in the bridge ID", "MAC": "MAC address"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no spanning-tree priority", "handler": "stp.unset:bridge-priority", "help": {"priority": "Default priority"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no spanning-tree hello-time", "handler": "stp.unset:hello-time", "help": {"hello-time": "Default hello time"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no spanning-tree max-age", "handler": "stp.unset:max-age", "help": {"max-age": "Default max age"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no spanning-tree forward-time", "handler": "stp.unset:forwarding-delay", "help": {"forward-time": "Default forward time"}},
    {"modes": ["config"], "kinds": ["switch"], "syntax": "no spanning-tree bridge-address", "handler": "stp.unset:openpacketrouter:bridge-address", "help": {"bridge-address": "Default bridge address"}},

    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "spanning-tree cost COST", "args": {"COST": "uint:1-200000000"}, "handler": "stp.port.set:cost",
     "help": {"spanning-tree": "Spanning tree settings of this port", "cost": "Path cost through this port (lower is preferred)", "COST": "Cost"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "spanning-tree port-priority PRIORITY", "args": {"PRIORITY": "uint:0-255"}, "handler": "stp.port.set:port-priority",
     "help": {"port-priority": "Breaks ties between ports (lower is preferred)", "PRIORITY": "Priority (default 128)"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "spanning-tree portfast", "handler": "stp.portfast",
     "help": {"portfast": "An edge port: a host hangs here, no switch, so rapid spanning tree forwards on it at once"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "no spanning-tree portfast", "handler": "stp.portfast.unset",
     "help": {"portfast": "Not an edge port (the switch still detects one by itself when no BPDU arrives)"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "no spanning-tree cost", "handler": "stp.port.unset:cost", "help": {"no": "Undo a setting", "cost": "Default cost"}},
    {"modes": ["config-if"], "kinds": ["switch"], "syntax": "no spanning-tree port-priority", "handler": "stp.port.unset:port-priority", "help": {"port-priority": "Default port priority"}}
  ]
}
