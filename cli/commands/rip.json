{
  "feature": "rip",
  "about": "RIPv2 in FRRouting's style: router rip, then network, passive-interface and timers basic. Split horizon and triggered updates are per router here (FRR sets them per interface).",
  "commands": [
    {"modes": ["config"], "kinds": ["router"], "syntax": "router rip", "handler": "rip.enter", "enter": "config-router",
     "help": {"router": "Routing protocols", "rip": "Routing Information Protocol (version 2)"}},
    {"modes": ["config"], "kinds": ["router"], "syntax": "no router rip", "handler": "rip.remove",
     "help": {"no": "Undo a setting", "router": "Routing protocols", "rip": "Turn RIP off"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "version 2", "handler": "rip.version",
     "help": {"version": "RIP version", "2": "RIPv2 (the only version)"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "network PREFIX", "args": {"PREFIX": "ipv4-prefix"}, "handler": "rip.network",
     "help": {"network": "Run RIP on interfaces inside this network", "PREFIX": "Network and prefix length"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "network IFNAME", "args": {"IFNAME": "word"}, "handler": "rip.network",
     "help": {"IFNAME": "Run RIP on this interface"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "no network PREFIX", "args": {"PREFIX": "ipv4-prefix"}, "handler": "rip.no-network",
     "help": {"no": "Undo a setting", "network": "Stop RIP on this network", "PREFIX": "Network and prefix length"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "no network IFNAME", "args": {"IFNAME": "word"}, "handler": "rip.no-network",
     "help": {"IFNAME": "Interface name"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "passive-interface IFNAME", "args": {"IFNAME": "word"}, "handler": "rip.passive",
     "help": {"passive-interface": "Hear RIP on this interface but do not send updates", "IFNAME": "Interface name"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "no passive-interface IFNAME", "args": {"IFNAME": "word"}, "handler": "rip.no-passive",
     "help": {"no": "Undo a setting", "passive-interface": "Send updates on this interface again", "IFNAME": "Interface name"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "timers basic UPDATE TIMEOUT GARBAGE", "args": {"UPDATE": "seconds", "TIMEOUT": "seconds", "GARBAGE": "seconds"}, "handler": "rip.timers",
     "help": {"timers": "RIP timers", "basic": "Update, timeout and garbage-collection timers", "UPDATE": "Seconds between updates (default 30)", "TIMEOUT": "Seconds before a silent route is invalid (default 180)", "GARBAGE": "Seconds an invalid route is kept (default 120)"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "no timers basic", "handler": "rip.no-timers",
     "help": {"no": "Undo a setting", "timers": "RIP timers", "basic": "Back to the default timers"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "split-horizon simple", "handler": "rip.split:simple",
     "help": {"split-horizon": "How routes learned on an interface are advertised back out of it", "simple": "Leave them out (the default)"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "split-horizon poisoned-reverse", "handler": "rip.split:poisoned",
     "help": {"poisoned-reverse": "Advertise them with metric 16"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "no split-horizon", "handler": "rip.split:off",
     "help": {"no": "Undo a setting", "split-horizon": "Advertise everything everywhere"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "triggered-updates", "handler": "rip.triggered:true",
     "help": {"triggered-updates": "Send changes at once (the default)"}},
    {"modes": ["config-router"], "kinds": ["router"], "syntax": "no triggered-updates", "handler": "rip.triggered:false",
     "help": {"no": "Undo a setting", "triggered-updates": "Wait for the update timer (a teaching setting, not in FRR)"}}
  ]
}
