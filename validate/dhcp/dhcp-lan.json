    {"name": "PC1", "kind": "host", "ifaces": {"eth0": "dhcp"}},
    {"name": "PC2", "kind": "host", "ifaces": {"eth0": "dhcp"}},
    {"name": "BYST", "kind": "host", "ifaces": {"eth0": "10.0.0.9/24"}}
  ],
  "links": [
    ["SRV:eth0", "SW:p1", 1], ["PC1:eth0", "SW:p2", 1], ["PC2:eth0", "SW:p3", 1], ["BYST:eth0", "SW:p4", 1]
  ]
}
