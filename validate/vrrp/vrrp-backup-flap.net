{
 "version": 1,
 "name": "vrrp-backup-flap",
 "about": "Same network as vrrp-preempt, but the lower-priority backup R2 loses its cable and gets it back while master R1 stays up: R1 must keep the address and R2 must return to backup.",
 "nodes": [
  {
   "name": "H1",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.0.10/24"
   },
   "gw": "10.0.0.254"
  },
  {
   "name": "S1",
   "kind": "switch"
  },
  {
   "name": "R1",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.0.1/24"
   },
   "vrrp": [
    {
     "iface": "eth0",
     "vrid": 1,
     "ip": "10.0.0.254",
     "priority": 200,
     "preempt": true
    }
   ]
  },
  {
   "name": "R2",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.0.2/24"
   },
   "vrrp": [
    {
     "iface": "eth0",
     "vrid": 1,
     "ip": "10.0.0.254",
     "priority": 100
    }
   ]
  }
 ],
 "links": [
  [
   "H1:eth0",
   "S1:p1"
  ],
  [
   "R1:eth0",
   "S1:p2"
  ],
  [
   "R2:eth0",
   "S1:p3"
  ]
 ]
}
