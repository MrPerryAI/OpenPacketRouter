{
 "version": 1,
 "name": "vrrp-nopreempt",
 "about": "Same network, but R1 does not preempt: after its cable returns it stays backup and R2 keeps the address.",
 "nodes": [
  {
   "name": "H1",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.0.10/24"
   },
   "gw": "10.0.0.254"
  },
  {
   "name": "S1",
   "kind": "switch"
  },
  {
   "name": "R1",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.0.1/24"
   },
   "vrrp": [
    {
     "iface": "eth0",
     "vrid": 1,
     "ip": "10.0.0.254",
     "priority": 200,
     "preempt": false
    }
   ]
  },
  {
   "name": "R2",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.0.2/24"
   },
   "vrrp": [
    {
     "iface": "eth0",
     "vrid": 1,
     "ip": "10.0.0.254",
     "priority": 100
    }
   ]
  }
 ],
 "links": [
  [
   "H1:eth0",
   "S1:p1"
  ],
  [
   "R1:eth0",
   "S1:p2"
  ],
  [
   "R2:eth0",
   "S1:p3"
  ]
 ]
}
