   "name": "SW1",
   "kind": "switch",
   "ports": {
    "f1": {
     "vlan": 1
    },
    "f2": {
     "vlan": 10
    },
    "trunk": {
     "trunk": [
      10
     ],
     "native": 1
    }
   }
  },
  {
   "name": "SW2",
   "kind": "switch",
   "ports": {
    "f1": {
     "vlan": 99
    },
    "f2": {
     "vlan": 1
    },
    "f3": {
     "vlan": 10
    },
    "trunk": {
     "trunk": [
      10
     ],
     "native": 99
    }
   }
  },
  {
   "name": "PC-A",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.0.1/24"
   }
  },
  {
