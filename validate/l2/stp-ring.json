   "name": "SW2",
   "kind": "switch",
   "stp": {
    "hello": 2,
    "forwardDelay": 4,
    "maxAge": 6
   }
  },
  {
   "name": "SW3",
   "kind": "switch",
   "stp": {
    "hello": 2,
    "forwardDelay": 4,
    "maxAge": 6
   },
   "ports": {
    "t2": {
     "priority": 64
    }
   }
  },
  {
   "name": "SW4",
   "kind": "switch",
   "stp": {
    "hello": 2,
    "forwardDelay": 4,
    "maxAge": 6
   },
   "ports": {
    "up": {
     "cost": 100
    }
   }
  },
  {
   "name": "SW1",
   "kind": "switch",
   "stp": {
    "hello": 2,
    "forwardDelay": 4,
    "maxAge": 6,
    "priority": 4096
   },
   "ports": {
