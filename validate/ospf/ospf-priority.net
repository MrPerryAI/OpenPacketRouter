{
 "version": 1,
 "name": "OSPF DR election by priority",
 "about": "Three routers on a switched LAN with priorities R1 = 10, R2 = 5, R3 = 0 (never DR or BDR): R1 is DR and R2 BDR although R3 has the highest router ID. R1's cable is cut: R2 takes over as DR; R3, ineligible, stays DROther, so there is no BDR. After the repair R1 rejoins as DROther.",
 "nodes": [
  {
   "name": "SW",
   "kind": "switch"
  },
  {
   "name": "R1",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.0.1/24",
    "eth1": "10.1.0.1/24"
   },
   "ospf": {
    "routerId": "1.1.1.1",
    "networks": [
     "10.0.0.0/8"
    ],
    "interfaces": {
     "eth0": {
      "hello": 1,
      "dead": 4,
      "priority": 10
     },
     "eth1": {
      "hello": 1,
      "dead": 4
     }
    },
    "passive": [
     "eth1"
    ]
   }
  },
  {
   "name": "R2",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.0.2/24"
   },
   "ospf": {
    "routerId": "2.2.2.2",
    "networks": [
     "10.0.0.0/8"
    ],
    "interfaces": {
     "eth0": {
      "hello": 1,
      "dead": 4,
      "priority": 5
     }
    }
   }
  },
  {
   "name": "R3",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.0.3/24",
    "eth1": "10.3.0.1/24"
   },
   "ospf": {
    "routerId": "3.3.3.3",
    "networks": [
     "10.0.0.0/8"
    ],
    "interfaces": {
     "eth0": {
      "hello": 1,
      "dead": 4,
      "priority": 0
     },
     "eth1": {
      "hello": 1,
      "dead": 4
     }
    },
    "passive": [
     "eth1"
    ]
   }
  },
  {
   "name": "H1",
   "kind": "host",
   "ifaces": {
    "eth0": "10.1.0.10/24"
   },
   "gw": "10.1.0.1"
  },
  {
   "name": "H3",
   "kind": "host",
   "ifaces": {
    "eth0": "10.3.0.10/24"
   },
   "gw": "10.3.0.1"
  }
 ],
 "links": [
  [
   "R1:eth0",
   "SW:p1",
   1
  ],
  [
   "R2:eth0",
   "SW:p2",
   1
  ],
  [
   "R3:eth0",
   "SW:p3",
   1
  ],
  [
   "H1:eth0",
   "R1:eth1",
   1
  ],
  [
   "H3:eth0",
   "R3:eth1",
   1
  ]
 ]
}