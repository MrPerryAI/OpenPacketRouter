{
 "version": 1,
 "name": "OSPF over point-to-point links and a transit LAN",
 "about": "Five routers. R1-R2 and R4-R5 are point-to-point links; R2, R3 and R4 share a switched LAN where R3 is DR (priority 5) and R4 BDR (priority 3). H1 is behind R1, H5 behind R5, both on passive interfaces. Paths cross the LAN's network LSA (R1 reaches R5 over R2, the LAN, R4). R2's cable to the switch is cut: R1 and H1 lose R5 and the LAN; R2 is not on the LAN any more, so R3 stays DR. After the repair R2 rejoins as DROther.",
 "nodes": [
  {
   "name": "SW",
   "kind": "switch"
  },
  {
   "name": "R1",
   "kind": "router",
   "ifaces": {
    "eth0": "10.12.0.1/24",
    "eth1": "10.1.0.1/24"
   },
   "ospf": {
    "routerId": "1.1.1.1",
    "networks": [
     "10.0.0.0/8"
    ],
    "interfaces": {
     "eth0": {
      "hello": 1,
      "dead": 4,
      "type": "point-to-point",
      "cost": 5
     },
     "eth1": {
      "hello": 1,
      "dead": 4
     }
    },
    "passive": [
     "eth1"
    ]
   }
  },
  {
