{
 "version": 1,
 "name": "OSPF timers: a mismatch keeps routers from becoming neighbors",
 "about": "The ring of ospf-p2p with three timer settings. R1-R2: hello 1 s on both but dead interval 4 s on R1 and 8 s on R2, so each drops the other's Hellos and they never become neighbors. R2-R3: both use hello 2 s / dead 8 s and do become neighbors. R1-R3 keeps hello 1 s / dead 4 s with cost 50 from R1. R1 therefore reaches H3 over the direct link, and R2 reaches R1 through R3. The R2-R3 cable is cut (R2 has no neighbors left) and restored.",
 "nodes": [
  {
   "name": "R1",
   "kind": "router",
   "ifaces": {
    "eth0": "10.12.0.1/24",
    "eth1": "10.13.0.1/24",
    "eth2": "10.1.0.1/24"
   },
   "ospf": {
    "routerId": "1.1.1.1",
    "networks": [
     "10.0.0.0/8"
    ],
    "interfaces": {
     "eth0": {
      "hello": 1,
      "dead": 4,
      "type": "point-to-point"
     },
     "eth1": {
      "hello": 1,
      "dead": 4,
      "type": "point-to-point",
      "cost": 50
     },
     "eth2": {
      "hello": 1,
      "dead": 4
     }
    },
    "passive": [
     "eth2"
    ]
   }
  },
  {
   "name": "R2",
   "kind": "router",
   "ifaces": {
    "eth0": "10.12.0.2/24",
    "eth1": "10.23.0.2/24"
   },
   "ospf": {
    "routerId": "2.2.2.2",
    "networks": [
     "10.0.0.0/8"
    ],
    "interfaces": {
     "eth0": {
      "hello": 1,
      "dead": 8,
      "type": "point-to-point"
     },
     "eth1": {
      "hello": 2,
      "dead": 8,
      "type": "point-to-point"
     }
    }
   }
  },
  {
   "name": "R3",
   "kind": "router",
   "ifaces": {
    "eth0": "10.13.0.3/24",
    "eth1": "10.23.0.3/24",
    "eth2": "10.3.0.1/24"
   },
   "ospf": {
    "routerId": "3.3.3.3",
    "networks": [
     "10.0.0.0/8"
    ],
    "interfaces": {
     "eth0": {
      "hello": 1,
      "dead": 4,
      "type": "point-to-point",
      "cost": 60
     },
     "eth1": {
      "hello": 2,
      "dead": 8,
      "type": "point-to-point"
     },
     "eth2": {
      "hello": 1,
      "dead": 4
     }
    },
    "passive": [
     "eth2"
    ]
   }
  },
  {
   "name": "H1",
   "kind": "host",
   "ifaces": {
    "eth0": "10.1.0.10/24"
   },
   "gw": "10.1.0.1"
  },
  {
   "name": "H3",
   "kind": "host",
   "ifaces": {
    "eth0": "10.3.0.10/24"
   },
   "gw": "10.3.0.1"
  }
 ],
 "links": [
  [
   "R1:eth0",
   "R2:eth0",
   1
  ],
  [
   "R2:eth1",
   "R3:eth1",
   1
  ],
  [
   "R1:eth1",
   "R3:eth0",
   1
  ],
  [
   "H1:eth0",
   "R1:eth2",
   1
  ],
  [
   "H3:eth0",
   "R3:eth2",
   1
  ]
 ]
}
