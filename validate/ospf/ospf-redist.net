{
 "version": 1,
 "name": "OSPF redistribution (ASBRs, type 5 external LSAs)",
 "about": "R2 is the ABR between area 1 (R1, H1) and the backbone. R3 and R4 are ASBRs in area 0. R3 redistributes its connected 10.30.0.0/24 (metric 30, type 1) and two static routes (default metric 20, type 2); R4 redistributes a static route to 10.99.0.0/24 with metric 10 (it beats R3's 20) and its connected 10.40.0.0/24 (20, type 2). R1 reaches the ASBRs through type 4 ASBR summary LSAs from R2. R3's LAN cable is cut (everything it redistributes is withdrawn) and restored; then R2-R4 is cut (R4's LSAs stay in the database but its ASBR is unreachable, so R3's 10.99.0.0/24 takes over) and restored.",
 "nodes": [
  {
   "name": "R1",
   "kind": "router",
   "ifaces": {
    "eth0": "10.12.0.1/24",
    "eth1": "10.1.0.1/24"
   },
   "ospf": {
    "routerId": "1.1.1.1",
    "networks": [
     {
      "network": "10.0.0.0/8",
      "area": 1
     }
    ],
    "interfaces": {
     "eth0": {
      "hello": 1,
      "dead": 4,
      "type": "point-to-point",
      "cost": 5
     },
     "eth1": {
      "hello": 1,
      "dead": 4
     }
    },
    "passive": [
     "eth1"
    ]
   }
  },
  {
   "name": "R2",
   "kind": "router",
   "ifaces": {
    "eth0": "10.12.0.2/24",
    "eth1": "10.23.0.2/24",
    "eth2": "10.24.0.2/24"
   },
   "ospf": {
