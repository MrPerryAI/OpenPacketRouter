{
 "version": 1,
 "name": "OSPF area range (route summarization at an ABR)",
 "about": "R2 is the ABR between area 1 (R1 with two LANs, 10.1.1.0/24 and 10.1.2.0/24) and the backbone (R3, H3). R2 summarizes area 1 with the range 10.1.0.0/16: R3 sees one summary LSA for the range, not the two LANs, at the largest cost of the routes inside it. R1's LAN 10.1.2.0/24 is then cut (the range stays while one route is inside) and R1-R2 is cut and restored (the range goes with its last route).",
 "nodes": [
  {
   "name": "R1",
   "kind": "router",
   "ifaces": {
    "eth0": "10.12.0.1/24",
    "eth1": "10.1.1.1/24",
    "eth2": "10.1.2.1/24"
   },
   "ospf": {
    "routerId": "1.1.1.1",
    "networks": [
     {
      "network": "10.0.0.0/8",
      "area": 1
     }
    ],
    "interfaces": {
     "eth0": {
      "hello": 1,
      "dead": 4,
      "type": "point-to-point",
      "cost": 5
     },
     "eth1": {
      "hello": 1,
      "dead": 4
     },
     "eth2": {
      "hello": 1,
      "dead": 4
     }
    },
    "passive": [
     "eth1",
     "eth2"
    ]
   }
  },
  {
   "name": "R2",
   "kind": "router",
   "ifaces": {
    "eth0": "10.12.0.2/24",
    "eth1": "10.23.0.2/24"
   },
