      "type": "point-to-point",
      "cost": 5
     },
     "eth1": {
      "hello": 1,
      "dead": 4,
      "type": "point-to-point",
      "cost": 10
     }
    },
    "ranges": [
     {
      "area": 1,
      "network": "10.1.0.0/16"
     }
    ]
   }
  },
  {
   "name": "R3",
