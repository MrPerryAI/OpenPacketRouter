{
 "version": 1,
 "name": "Router on a stick",
 "about": "R routes between VLANs 10 and 20 over one trunk cable using 802.1Q subinterfaces eth0.10 and eth0.20; its untagged eth0 is on the native VLAN 1. SW1 and SW2 are VLAN-aware switches joined by a trunk. E is in VLAN 30, which R has no subinterface for.",
 "nodes": [
  {
   "name": "R",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.1.1/24",
    "eth0.10": "10.0.10.1/24",
    "eth0.20": "10.0.20.1/24"
   }
  },
  {
   "name": "SW1",
   "kind": "switch",
   "vlans": {
    "up0": {
     "trunk": [
      10,
      20
     ],
     "native": 1
    },
    "p1": {
     "access": 10
    },
    "p2": {
     "access": 20
    },
    "p3": {
     "access": 1
    },
    "tr0": {
     "trunk": [
      10,
      20,
      30
     ]
    }
   }
  },
  {
   "name": "SW2",
   "kind": "switch",
   "vlans": {
    "tr0": {
     "trunk": [
      10,
      20,
      30
     ]
    },
    "p1": {
     "access": 10
    },
    "p2": {
     "access": 20
    },
    "p3": {
     "access": 30
    }
   }
  },
  {
   "name": "A",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.10.11/24"
   },
   "gw": "10.0.10.1"
  },
  {
   "name": "B",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.20.12/24"
   },
   "gw": "10.0.20.1"
  },
  {
   "name": "N",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.1.13/24"
   },
   "gw": "10.0.1.1"
  },
  {
   "name": "C",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.10.21/24"
   },
   "gw": "10.0.10.1"
  },
  {
   "name": "D",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.20.22/24"
   },
   "gw": "10.0.20.1"
  },
  {
   "name": "E",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.30.23/24"
   },
   "gw": "10.0.30.1"
  }
 ],
 "links": [
  [
   "R:eth0",
   "SW1:up0"
  ],
  [
   "A:eth0",
   "SW1:p1"
  ],
  [
   "B:eth0",
   "SW1:p2"
  ],
  [
   "N:eth0",
   "SW1:p3"
  ],
  [
   "SW1:tr0",
   "SW2:tr0"
  ],
  [
   "C:eth0",
   "SW2:p1"
  ],
  [
   "D:eth0",
   "SW2:p2"
  ],
  [
   "E:eth0",
   "SW2:p3"
  ]
 ]
}
