     "10.1.0.0/24"
    ],
    "timers": {
     "keepalive": 1,
     "hold": 3,
     "connect": 5
    },
    "neighbors": [
     {
      "ip": "10.12.0.2",
      "remoteAs": 65002
     }
    ]
   }
  },
