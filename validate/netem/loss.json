    {"name": "C", "kind": "host", "ifaces": {"eth0": "10.0.0.3/24"}}
  ],
  "links": [
    ["A:eth0", "SW:p1", 2, {"loss": {"toBad": 1, "toGood": 1, "inBad": 1, "inGood": 0}}],
    ["B:eth0", "SW:p2", 2],
    ["C:eth0", "SW:p3", 2, {"loss": {"toBad": 0, "toGood": 0, "inBad": 0, "inGood": 1}}]
  ]
