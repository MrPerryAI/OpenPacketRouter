{
 "version": 1,
 "name": "VRRP gateway",
 "about": "Host H1 uses 10.0.0.254 as its gateway. Routers R1 (priority 200) and R2 (100) share that address: R1 is master. Cut R1's cable and R2 takes the address over, so the ping keeps working.",
 "nodes": [
  {
   "name": "H1",
   "kind": "host",
   "ifaces": {
    "eth0": "10.0.0.10/24"
   },
   "gw": "10.0.0.254"
  },
  {
   "name": "S1",
   "kind": "switch"
  },
  {
   "name": "R1",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.0.1/24"
   },
   "vrrp": [
    {
     "iface": "eth0",
     "vrid": 1,
     "ip": "10.0.0.254",
     "priority": 200
    }
   ]
  },
  {
   "name": "R2",
   "kind": "router",
   "ifaces": {
    "eth0": "10.0.0.2/24"
   },
   "vrrp": [
    {
     "iface": "eth0",
     "vrid": 1,
     "ip": "10.0.0.254",
     "priority": 100
    }
   ]
  }
 ],
 "links": [
  [
   "H1:eth0",
   "S1:p1"
  ],
  [
   "R1:eth0",
   "S1:p2"
  ],
  [
   "R2:eth0",
   "S1:p3"
  ]
 ]
}