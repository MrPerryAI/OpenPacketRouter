{
  "version": 1,
  "name": "TCP across a router",
  "about": "A client, a router and two echo servers (TCP port 7). SERVER has a default route back to the client; BROKEN has no gateway, so it never answers and the client's SYN is retransmitted.",
  "nodes": [
    {"name": "SW1", "kind": "switch"},
    {"name": "SW2", "kind": "switch"},
    {"name": "R1", "kind": "router", "ifaces": {"eth0": "10.1.0.1/24", "eth1": "10.2.0.1/24"}},
    {"name": "CLIENT", "kind": "host", "ifaces": {"eth0": "10.1.0.10/24"}, "gw": "10.1.0.1"},
    {"name": "SERVER", "kind": "server", "ifaces": {"eth0": "10.2.0.10/24"}, "gw": "10.2.0.1", "services": {"tcp": {"7": "echo"}}},
    {"name": "BROKEN", "kind": "server", "ifaces": {"eth0": "10.2.0.20/24"}, "services": {"tcp": {"7": "echo"}}}
  ],
  "links": [["CLIENT:eth0", "SW1:p1"], ["R1:eth0", "SW1:p2"], ["R1:eth1", "SW2:p1"], ["SERVER:eth0", "SW2:p2"], ["BROKEN:eth0", "SW2:p3"]]
}
