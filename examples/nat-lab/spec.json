{
 "version": 1,
 "name": "NAT on a router",
 "about": "Inside LAN 10.1.0.0/24 behind router R, outside LAN 203.0.113.0/24 with server S. B and W share R's outside address (overload); A has the static address 203.0.113.10 (1:1); S reaches W's web port through R's address on port 8080 (port forward).",
 "nodes": [
  {
   "name": "A",
   "kind": "server",
   "ifaces": {
    "eth0": "10.1.0.10/24"
   },
   "gw": "10.1.0.1",
   "services": {
    "tcp": {
     "7": "echo"
    }
   }
  },
  {
   "name": "B",
   "kind": "host",
   "ifaces": {
    "eth0": "10.1.0.11/24"
   },
   "gw": "10.1.0.1"
  },
  {
   "name": "W",
   "kind": "server",
   "ifaces": {
    "eth0": "10.1.0.20/24"
   },
   "gw": "10.1.0.1",
   "services": {
    "tcp": {
     "80": "echo"
    }
   }
  },
  {
   "name": "SW",
   "kind": "switch"
  },
  {
   "name": "R",
   "kind": "router",
   "ifaces": {
    "eth0": "10.1.0.1/24",
    "eth1": "203.0.113.1/24"
   },
   "nat": {
    "inside": [
     "eth0"
    ],
    "outside": [
     "eth1"
    ],
    "overload": {
     "src": "10.1.0.0/24"
    },
    "static": [
     {
      "inside": "10.1.0.10",
      "outside": "203.0.113.10"
     },
     {
      "proto": "tcp",
      "inside": "10.1.0.20",
      "insidePort": 80,
      "outside": "203.0.113.1",
      "outsidePort": 8080
     }
    ]
   }
  },
  {
   "name": "S",
   "kind": "server",
   "ifaces": {
    "eth0": "203.0.113.50/24"
   },
   "services": {
    "dns": {
     "srv.lab": "203.0.113.50"
    },
    "tcp": {
     "7": "echo",
     "80": "echo"
    }
   }
  }
 ],
 "links": [
  [
   "A:eth0",
   "SW:p1",
   1
  ],
  [
   "B:eth0",
   "SW:p2",
   1
  ],
  [
   "W:eth0",
   "SW:p3",
   1
  ],
  [
   "R:eth0",
   "SW:p4",
   1
  ],
  [
   "R:eth1",
   "S:eth0",
   1
  ]
 ]
}